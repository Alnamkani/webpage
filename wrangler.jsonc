{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alnamkani-com",
  "compatibility_date": "2026-08-20",
  "workers_dev": true,
  "routes": [
    { "pattern": "alnamkani.com", "custom_domain": true },
    { "pattern": "www.alnamkani.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash"
  }
}
