{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alnamkani-com",
  "compatibility_date": "2026-08-20",
  "main": "src/worker.js",
  "workers_dev": false,
  "routes": [
    { "pattern": "alnamkani.com", "custom_domain": true },
    { "pattern": "www.alnamkani.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash"
  },
  "kv_namespaces": [
    { "binding": "DRAWINGS", "id": "75d0aaa00e1a4256a6f98e65a30abdbf" }
  ],
  "durable_objects": {
    "bindings": [{ "name": "GYM", "class_name": "Gym" }]
  },
  "migrations": [{ "tag": "gym-v1", "new_sqlite_classes": ["Gym"] }],
  "vars": {
    // Boulder Gym reset day: how often the wall is stripped. 168 = weekly.
    "RESET_HOURS": "168"
  },
  "env": {
    "preview": {
      "name": "alnamkani-com-preview",
      "workers_dev": true,
      "routes": [],
      "assets": {
        "directory": "./public",
        "binding": "ASSETS",
        "html_handling": "auto-trailing-slash"
      },
      "kv_namespaces": [
        { "binding": "DRAWINGS", "id": "75d0aaa00e1a4256a6f98e65a30abdbf" }
      ],
      "durable_objects": {
        "bindings": [{ "name": "GYM", "class_name": "Gym" }]
      },
      "migrations": [{ "tag": "gym-v1", "new_sqlite_classes": ["Gym"] }],
      "vars": { "RESET_HOURS": "168" }
    }
  }
}
